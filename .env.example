# === API Provider ===
# "anthropic" (default) or "openrouter"
API_PROVIDER=anthropic

# === Model ===
# Default: claude-sonnet-4-5-20250514
# OpenRouter examples: anthropic/claude-sonnet-4-5, google/gemini-2.5-pro, openai/gpt-4o, meta-llama/llama-4-maverick
MODEL=claude-sonnet-4-5-20250514

# === API Keys (set the one matching your provider) ===
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...

# === Optional: site URL for OpenRouter rankings ===
SITE_URL=https://pionex-growth-lab.up.railway.app
