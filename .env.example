# === API Provider ===
# "anthropic" (default) or "openrouter"
API_PROVIDER=openrouter

# === Model (optional) ===
# Leave empty to auto-use free models with fallback chain:
#   1. openrouter/free (auto-router picks best available free model)
#   2. qwen/qwen3-coder:free
#   3. qwen/qwen-2.5-coder-32b-instruct:free
#   4. qwen/qwen2.5-vl-3b-instruct:free
#   5. meta-llama/llama-3.3-70b-instruct:free
#   6. google/gemma-3-27b-it:free
#   7. mistralai/mistral-small-3.1-24b-instruct:free
#   8. nvidia/llama-3.1-nemotron-70b-instruct:free
# Or set a specific model:
# MODEL=openrouter/free

# === API Keys (set the one matching your provider) ===
# ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...

# === Optional: site URL for OpenRouter rankings ===
SITE_URL=https://pionex-growth-lab-production.up.railway.app
