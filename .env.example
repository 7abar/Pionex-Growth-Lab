# === API Provider ===
# "anthropic" (default) or "openrouter"
API_PROVIDER=openrouter

# === Model (optional) ===
# Leave empty to auto-use free models with fallback chain:
#   1. qwen/qwen3-235b-a22b:free
#   2. qwen/qwen3-30b-a3b:free
#   3. deepseek/deepseek-chat-v3-0324:free
#   4. meta-llama/llama-4-maverick:free
#   5. google/gemma-3-27b-it:free
#   6. mistralai/mistral-small-3.1-24b-instruct:free
# Or set a specific model:
# MODEL=qwen/qwen3-235b-a22b:free

# === API Keys (set the one matching your provider) ===
# ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...

# === Optional: site URL for OpenRouter rankings ===
SITE_URL=https://pionex-growth-lab-production.up.railway.app
